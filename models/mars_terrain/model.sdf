<?xml version="1.0"?>
<sdf version="1.9">
  <model name="mars_arena">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>
    <link name="terrain">
      <visual name="terrain_visual">
        <geometry>
          <mesh>
            <uri>meshes/mars_terrain.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <!-- OBJ source is Y-up; rotate it into Gazebo's Z-up frame. -->
        <pose>0 0 0 1.57079632679 0 0</pose>
        <cast_shadows>true</cast_shadows>
      </visual>

      <collision name="terrain_collision">
        <geometry>
          <mesh>
            <uri>meshes/arena_terrain_collision.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <!-- Collision STL was converted to Z-up during export. -->
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>100</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
